# Sao chép thành deploy.env (KHÔNG commit) rồi điền.
HUB=your-dockerhub-user          # Docker Hub: image <HUB>/mu-web, <HUB>/mu-gateway (tạo repo private)
VPS=root@203.0.113.10            # ssh tới manager Swarm
VPS_PORT=22
MU_DIR=/opt/mu                   # thư mục dữ liệu trên VPS
HTTP_PORT=8090                   # cổng nginx trên VPS
DOMAIN=mu.example.com            # tên miền công khai (proxy phía trước trỏ về VPS:HTTP_PORT)
